{
  "name": "okul-zil",
  "productName": "Okul Zil ve Pano",
  "version": "0.2.0",
  "description": "Okul zil sistemi, koridor panosu, törenler ve acil durum alarmları tek programda",
  "main": "main.js",
  "author": "Ömer Faruk Çetin",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "server": "node server/standalone.js",
    "test": "node test/scheduler.test.js",
    "dist": "electron-builder --win --publish never"
  },
  "dependencies": {
    "adm-zip": "^0.5.18",
    "express": "^4.21.2"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "tr.okul.zil",
    "productName": "Okul Zil ve Pano",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "server/**",
      "public/**",
      "sounds/**",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "artifactName": "OkulZil-Kurulum-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Okul Zil ve Pano",
      "runAfterFinish": true
    }
  }
}
